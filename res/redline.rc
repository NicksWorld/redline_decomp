#include "resource.h"

APP_ICON ICON "redline.ico"

1 VERSIONINFO
FILEVERSION 1,0,0,1
PRODUCTVERSION 1,0,0,1
FILEOS 0x40004
FILETYPE 0x1 {
    BLOCK "StringFileInfo" {
        BLOCK "040904b0" {
            VALUE "CompanyName", "Beyond Games, Inc."
            VALUE "FileDescription", "wheels"
            VALUE "FileVersion", "1, 0, 0, 1"
            VALUE "InternalName", "wheels"
            VALUE "LegalCopyright", "Copyright \xA9 1996"
            VALUE "OriginalFilename", "Wheels.exe"
            VALUE "ProductName", "Beyond Games, Inc. Wheels"
            VALUE "ProductVersion", "1, 0, 0, 1"
        }
    }

    BLOCK "VarFileInfo" {
        VALUE "Translation", 0x0409, 0x04B0
    }
}
